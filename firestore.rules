rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidNumber(val, minVal) {
      return val is number && val >= minVal;
    }

    match /residents/{residentId} {
      allow read: if true;
      allow write: if true;
    }

    match /payments/{paymentId} {
      allow read: if true;
      allow write: if true;
    }

    match /expenses/{expenseId} {
      allow read: if true;
      allow write: if true;
    }

    match /otherIncomes/{otherIncomeId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
